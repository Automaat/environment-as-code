{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitType(chore)",
    ":semanticCommitScope(deps)"
  ],
  "labels": ["dependencies"],
  "reviewers": ["Automaat"],
  "automerge": false,
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in workflow inputs behind a `# renovate:` comment, e.g. mise in jdx/mise-action.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"],
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Non-major updates merge on their own once the required checks pass, through GitHub native auto-merge.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Batch routine CLI tool bumps from the global mise config into one weekly PR, gated by the e2e CI job.",
      "matchManagers": ["mise"],
      "matchFileNames": ["dotfiles/mise/config.toml"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools",
      "schedule": ["* 0-5 * * 1"],
      "addLabels": ["mise"]
    },
    {
      "description": "Major bumps can change CLI or API behavior; review them one at a time.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    },
    {
      "description": "Stay on Python 3.13.",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.14"
    },
    {
      "description": "eac's own Go toolchain and dependencies.",
      "matchFileNames": ["go.mod", "mise.toml"],
      "groupName": "eac toolchain",
      "groupSlug": "eac-toolchain",
      "addLabels": ["go"]
    },
    {
      "description": "Go is pinned in both mise configs; bump them in one PR so eac and the global toolchain never drift apart.",
      "matchManagers": ["mise"],
      "matchDepNames": ["go"],
      "matchFileNames": ["mise.toml", "dotfiles/mise/config.toml"],
      "groupName": "go",
      "groupSlug": "go",
      "schedule": ["at any time"],
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    }
  ]
}
