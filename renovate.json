{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitType(chore)",
    ":semanticCommitScope(deps)"
  ],
  "labels": ["dependencies", "automerge"],
  "reviewers": ["Automaat"],
  "automerge": true,
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Batch routine CLI tool bumps from the global mise config into one weekly PR, gated by the tools CI job.",
      "matchManagers": ["mise"],
      "matchFileNames": ["dotfiles/mise/config.toml"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools",
      "groupSlug": "mise-tools",
      "schedule": ["* 0-5 * * 1"],
      "addLabels": ["mise"]
    },
    {
      "description": "Major tool bumps can change CLI behavior; review them one at a time.",
      "matchManagers": ["mise"],
      "matchFileNames": ["dotfiles/mise/config.toml"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["mise", "major"]
    },
    {
      "description": "eac's own Go toolchain and dependencies.",
      "matchFileNames": ["go.mod", "mise.toml"],
      "groupName": "eac toolchain",
      "groupSlug": "eac-toolchain",
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    }
  ]
}
