<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.eac.check</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{.Home}}/.local/bin/eac-check-notify</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>{{.Home}}/Library/Logs/eac-check.log</string>
	<key>StandardErrorPath</key>
	<string>{{.Home}}/Library/Logs/eac-check.log</string>
</dict>
</plist>
