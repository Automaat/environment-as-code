typeset -U path fpath

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_FCNTL_LOCK EXTENDED_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE SHARE_HISTORY
setopt AUTO_CD

autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

ZSH_CLEAN_HISTORY_AUTO_CLEAN=false

ZSH_AUTOSUGGEST_STRATEGY=(history)
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main)

ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$ZSH_CACHE_DIR/completions" ]] || command mkdir -p -- "$ZSH_CACHE_DIR/completions"
fpath=("$ZSH_CACHE_DIR/completions" $fpath)
autoload -Uz compinit zrecompile
zmodload zsh/datetime zsh/stat
zcompdump="$ZSH_CACHE_DIR/zcompdump-$ZSH_VERSION"
if [[ -s "$zcompdump" ]] && (( EPOCHSECONDS - $(zstat +mtime "$zcompdump") < 86400 )); then
  compinit -C -d "$zcompdump"
else
  compinit -d "$zcompdump"
  zrecompile -pq "$zcompdump"
fi

zstyle ':antidote:*' zcompile yes
source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh

[[ ! -r ~/.opam/opam-init/init.zsh ]] || source ~/.opam/opam-init/init.zsh > /dev/null 2> /dev/null

alias g=git
alias ga='git add'
alias gcb='git checkout -b'
alias gco='git checkout'
alias gcmsg='git commit --message'
alias gd='git diff'
alias gl='git pull'
alias gst='git status'
alias sb="cd $HOME/Documents/secon-brain-sync"
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

take() {
  (( $# )) || return 1
  command mkdir -p -- "$@" && builtin cd -- "${@[-1]}"
}

if [[ -d "$HOME/kong" ]]; then
  alias sync-kuma="gh repo sync automaat/kuma -b master"
  alias sync-kuma-website="gh repo sync automaat/kuma-website -b master"
  alias awsk="aws --profile saml --region us-west-1"
  alias kol="bash $HOME/kong/konnect-on-call-tool-kit/cli/kolsch.sh"
  alias kctl="$HOME/kong/mesh/kuma/build/artifacts-darwin-arm64/kumactl/kumactl"
fi

[[ ! -d "$HOME/.kuma-dev/kuma-master/bin" ]] || path=("$HOME/.kuma-dev/kuma-master/bin" $path)
[[ ! -d "$HOME/.antigravity/antigravity/bin" ]] || path=("$HOME/.antigravity/antigravity/bin" $path)
path=($path "$HOME/go/bin" "$HOME/.local/bin" "/opt/homebrew/share/google-cloud-sdk/bin")

eval "$(mise activate zsh)"

source <(fzf --zsh)
[[ ! -r /opt/homebrew/opt/autojump/etc/profile.d/autojump.sh ]] || source /opt/homebrew/opt/autojump/etc/profile.d/autojump.sh

_saml2aws() {
  local matches=($(${words[1]} --completion-bash "${(@)words[2,$CURRENT]}"))
  compadd -a matches
  (( compstate[nmatches] )) || [[ $words[$CURRENT] == -* ]] || _files
}
compdef _saml2aws saml2aws

npm_token() {
  [[ -n ${NPM_TOKEN:-} ]] && return 0
  local acct=${OP_ACCOUNT:-}
  local ref=${NPM_TOKEN_OP_REF:-}
  [[ -n $ref && -n $acct ]] || return 0
  local t
  t=$(op read $ref --account $acct 2>/dev/null)
  if [[ -z $t ]] && [[ -o interactive ]]; then
    eval "$(op signin --account $acct)" 2>/dev/null
    t=$(op read $ref --account $acct 2>/dev/null)
  fi
  if [[ -z $t ]]; then
    print -u2 "NPM_TOKEN: 1Password did not answer. Try: eval \"\$(op signin --account $acct)\""
    return 1
  fi
  export NPM_TOKEN=$t
}

eval "$(starship init zsh)"
eval "$(direnv hook zsh)"
antidote load ~/.config/zsh/zsh_plugins.txt
export GPG_TTY=$TTY
