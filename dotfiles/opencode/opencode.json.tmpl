{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "kong-ai-gateway"
  ],
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch --show-current*": "allow"
    },
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "chrome-devtools_*": "deny",
    "datadog-mcp_*": "deny"
  },
  "agent": {
    "explore": {
      "description": "Repository exploration with no edit tool and no external services",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "chrome-devtools_*": "deny",
        "datadog-mcp_*": "deny"
      }
    },
    "review": {
      "description": "Review with no edit tool and opt-in Datadog evidence",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "chrome-devtools_*": "deny",
        "datadog-mcp_*": "allow"
      }
    },
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "pwd": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch --show-current*": "allow",
          "mise run lint*": "allow",
          "mise run test*": "allow",
          "npm test*": "allow",
          "npm run check*": "allow",
          "go test *": "allow",
          "cargo test *": "allow"
        },
        "chrome-devtools_*": "allow",
        "datadog-mcp_*": "deny"
      }
    },
    "release": {
      "description": "Last-mile delivery without prompts",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "chrome-devtools_*": "deny",
        "datadog-mcp_*": "deny"
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "{{.Home}}/.local/share/mise/shims/chrome-devtools-mcp"
      ],
      "enabled": true
    },
    "datadog-mcp": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
      "enabled": true
    }
  },
  "model": "kong-ai-gateway/zai-org/GLM-5.3-Flash",
  "plugin": [
    [
      "file://{{.Home}}/kong/opencode-plugin-kong-ai-gateway/src/index.ts",
      {
        "gateway": "https://us.ai-gw.konghq.tech",
        "issuer": "https://konghq.okta.com/oauth2/default",
        "clientID": "0oa1zlwt4wuQdH7xt358",
        "audience": "api://default",
        "redirectURI": "http://localhost:9876/callback"
      }
    ],
    [
      "opencode-plugin-comment-judge@0.3.0",
      {
        "log": "{{.Home}}/.local/share/opencode/comment-judge.jsonl"
      }
    ]
  ],
  "small_model": "kong-ai-gateway/zai-org/GLM-5.3-Flash",
  "plugins": [
    {
      "package": "{{.Home}}/.config/opencode/kong-ai-gateway-v2",
      "options": {
        "gateway": "https://us.ai-gw.konghq.tech",
        "issuer": "https://konghq.okta.com/oauth2/default",
        "clientID": "0oa1zlwt4wuQdH7xt358",
        "audience": "api://default",
        "redirectURI": "http://localhost:9876/callback"
      }
    },
    "{{.Home}}/sideprojects/opencode-plugin-plan-review"
  ]
}
