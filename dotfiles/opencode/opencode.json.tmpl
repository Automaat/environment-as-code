{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "kong-ai-gateway"
  ],
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "edit": "allow",
    "bash": {{ agentPermissions "opencode" "allow" }},
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "chrome-devtools_*": "deny",
    "datadog_*": "deny"
  },
  "agent": {
    "explore": {
      "description": "Repository exploration with no edit tool and no external services",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "chrome-devtools_*": "deny",
        "datadog_*": "deny"
      }
    },
    "review": {
      "description": "Review with no edit tool and opt-in Datadog evidence",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "chrome-devtools_*": "deny",
        "datadog_*": "allow"
      }
    },
    "build": {
      "permission": {
        "edit": "allow",
        "bash": {{ agentPermissions "opencode" "allow" }},
        "chrome-devtools_*": "allow",
        "datadog_*": "deny"
      }
    },
    "release": {
      "description": "Last-mile delivery without prompts",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "chrome-devtools_*": "deny",
        "datadog_*": "deny"
      }
    }
  },
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://us.ai-gw.konghq.tech/mcp/atlassian-rovo",
        "oauth": {
          "client_id": "0oa1zlwt4wuQdH7xt358",
          "callback_port": 54661
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "{{.Home}}/.local/share/mise/shims/chrome-devtools-mcp"
        ],
        "disabled": true
      },
      "datadog": {
        "type": "remote",
        "url": "https://us.ai-gw.konghq.tech/mcp/datadog",
        "oauth": {
          "client_id": "0oa1zlwt4wuQdH7xt358",
          "callback_port": 54661
        }
      },
      "sail-shared-memory": {
        "type": "local",
        "command": [
          "{{.Home}}/.local/bin/sail-memory-mcp",
          "--memory-mcp"
        ],
        "environment": {
          "SAIL_MEMORY_AGENT": "opencode",
          "SAIL_MEMORY_ROOT": "{{.Home}}/Library/Application Support/dev.smykla.sai-harness/memory",
          "SAIL_SETTINGS_PATH": "{{.Home}}/Library/Application Support/sail/settings.json"
        }
      },
      "slack": {
        "type": "remote",
        "url": "https://us.ai-gw.konghq.tech/mcp/slack",
        "oauth": {
          "client_id": "0oa1zlwt4wuQdH7xt358",
          "callback_port": 54661
        }
      }
    }
  },
  "model": "kong-ai-gateway/zai-org/GLM-5.3-Flash",
  "plugin": [
    [
      "file://{{.Home}}/kong/opencode-plugin-kong-ai-gateway/src/index.ts",
      {
        "gateway": "https://us.ai-gw.konghq.tech",
        "issuer": "https://konghq.okta.com/oauth2/default",
        "clientID": "0oa1zlwt4wuQdH7xt358",
        "audience": "api://default",
        "redirectURI": "http://localhost:9876/callback"
      }
    ],
    [
      "opencode-plugin-comment-judge@0.3.0",
      {
        "log": "{{.Home}}/.local/share/opencode/comment-judge.jsonl"
      }
    ]
  ],
  "small_model": "kong-ai-gateway/zai-org/GLM-5.3-Flash",
  "plugins": [
    {
      "package": "{{.Home}}/.config/opencode/kong-ai-gateway-v2",
      "options": {
        "gateway": "https://us.ai-gw.konghq.tech",
        "issuer": "https://konghq.okta.com/oauth2/default",
        "clientID": "0oa1zlwt4wuQdH7xt358",
        "audience": "api://default",
        "redirectURI": "http://localhost:9876/callback"
      }
    }
  ]
}
