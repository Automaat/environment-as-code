{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "kong-bg": "#cdd4cb",
    "kong-panel": "#ffffff",
    "kong-element": "#e8ebe3",
    "kong-primary": "#ccff00",
    "kong-text": "#4a4d49",
    "kong-text-strong": "#1a1d18",
    "kong-text-muted": "#7a8075",
    "kong-border": "#bfc4b8",
    "kong-border-active": "#a0b050",
    "kong-border-subtle": "#dde0da",
    "kong-error": "#cc0000",
    "kong-success": "#008a36",
    "kong-warning": "#c88a00",
    "kong-info": "#1a6fcf",
    "kong-diff-green-bg": "#d4f5e0",
    "kong-diff-red-bg": "#fce0e0"
  },
  "theme": {
    "primary": { "dark": "kong-primary", "light": "kong-primary" },
    "secondary": { "dark": "#7a9940", "light": "#7a9940" },
    "accent": { "dark": "kong-primary", "light": "kong-primary" },
    "error": { "dark": "kong-error", "light": "kong-error" },
    "warning": { "dark": "kong-warning", "light": "kong-warning" },
    "success": { "dark": "kong-success", "light": "kong-success" },
    "info": { "dark": "kong-info", "light": "kong-info" },
    "text": { "dark": "kong-text", "light": "kong-text" },
    "textMuted": { "dark": "kong-text-muted", "light": "kong-text-muted" },
    "background": { "dark": "kong-bg", "light": "kong-bg" },
    "backgroundPanel": { "dark": "kong-panel", "light": "kong-panel" },
    "backgroundElement": { "dark": "kong-element", "light": "kong-element" },
    "border": { "dark": "kong-border", "light": "kong-border" },
    "borderActive": { "dark": "kong-border-active", "light": "kong-border-active" },
    "borderSubtle": { "dark": "kong-border-subtle", "light": "kong-border-subtle" },
    "diffAdded": { "dark": "kong-success", "light": "kong-success" },
    "diffRemoved": { "dark": "kong-error", "light": "kong-error" },
    "diffContext": { "dark": "kong-text-muted", "light": "kong-text-muted" },
    "diffHunkHeader": { "dark": "kong-border", "light": "kong-border" },
    "diffHighlightAdded": { "dark": "kong-success", "light": "kong-success" },
    "diffHighlightRemoved": { "dark": "kong-error", "light": "kong-error" },
    "diffAddedBg": { "dark": "kong-diff-green-bg", "light": "kong-diff-green-bg" },
    "diffRemovedBg": { "dark": "kong-diff-red-bg", "light": "kong-diff-red-bg" },
    "diffContextBg": { "dark": "kong-panel", "light": "kong-panel" },
    "diffLineNumber": { "dark": "kong-text-muted", "light": "kong-text-muted" },
    "diffAddedLineNumberBg": { "dark": "kong-diff-green-bg", "light": "kong-diff-green-bg" },
    "diffRemovedLineNumberBg": { "dark": "kong-diff-red-bg", "light": "kong-diff-red-bg" },
    "markdownText": { "dark": "kong-text", "light": "kong-text" },
    "markdownHeading": { "dark": "#5a7a10", "light": "#5a7a10" },
    "markdownLink": { "dark": "#5a7a10", "light": "#5a7a10" },
    "markdownLinkText": { "dark": "kong-text-strong", "light": "kong-text-strong" },
    "markdownCode": { "dark": "kong-success", "light": "kong-success" },
    "markdownBlockQuote": { "dark": "kong-text-muted", "light": "kong-text-muted" },
    "markdownEmph": { "dark": "kong-text-strong", "light": "kong-text-strong" },
    "markdownStrong": { "dark": "#5a7a10", "light": "#5a7a10" },
    "markdownHorizontalRule": { "dark": "kong-border", "light": "kong-border" },
    "markdownListItem": { "dark": "#5a7a10", "light": "#5a7a10" },
    "markdownListEnumeration": { "dark": "#5a7a10", "light": "#5a7a10" },
    "markdownImage": { "dark": "#5a7a10", "light": "#5a7a10" },
    "markdownImageText": { "dark": "kong-text-strong", "light": "kong-text-strong" },
    "markdownCodeBlock": { "dark": "kong-text", "light": "kong-text" },
    "syntaxComment": { "dark": "#8a9480", "light": "#8a9480" },
    "syntaxKeyword": { "dark": "#5a7a10", "light": "#5a7a10" },
    "syntaxFunction": { "dark": "kong-info", "light": "kong-info" },
    "syntaxVariable": { "dark": "kong-text-strong", "light": "kong-text-strong" },
    "syntaxString": { "dark": "#008a36", "light": "#008a36" },
    "syntaxNumber": { "dark": "kong-warning", "light": "kong-warning" },
    "syntaxType": { "dark": "#3a6a28", "light": "#3a6a28" },
    "syntaxOperator": { "dark": "#5a6055", "light": "#5a6055" },
    "syntaxPunctuation": { "dark": "#6a7065", "light": "#6a7065" }
  }
}
