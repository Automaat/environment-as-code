#!/bin/sh
set -eu

repo="${EAC_REPO:-$HOME/sideprojects/environment-as-code}"
if [ ! -f "$repo/eac.yaml" ]; then
    echo "eac: no eac.yaml in $repo (set EAC_REPO)" >&2
    exit 1
fi

bin="${XDG_CACHE_HOME:-$HOME/Library/Caches}/eac/eac"
(cd "$repo" && mise exec -- go build -o "$bin" ./cmd/eac)
exec "$bin" -c "$repo/eac.yaml" "$@"
