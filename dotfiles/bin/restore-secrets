#!/bin/sh
set -eu
umask 077

manifest="$HOME/.config/restore-secrets/secrets.tsv"
tab=$(printf '\t')
tmp=""
unlocked=""

cleanup() {
    if [ -n "$tmp" ]; then rm -f "$tmp"; fi
    if [ -n "$unlocked" ]; then bw lock > /dev/null 2>&1 || true; fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

expand_path() {
    case "$1" in
        \~/*) printf '%s/%s\n' "$HOME" "${1#\~/}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

has_key() {
    [ -f "$1" ] && age-keygen -y "$1" 2> /dev/null | grep -qxF "$2"
}

missing_items() {
    while IFS="$tab" read -r path item recipient <&3; do
        case "$path" in "" | "#"*) continue ;; esac
        if ! has_key "$(expand_path "$path")" "$recipient"; then
            printf '%s\n' "$item"
        fi
    done 3< "$manifest"
}

open_vault() {
    if [ ! -t 0 ]; then
        echo "restore-secrets needs your master password. Run zakwas apply in a terminal." >&2
        exit 1
    fi
    case "$(bw status)" in
        *'"status":"unauthenticated"'*) BW_SESSION=$(bw login --raw) ;;
        *) BW_SESSION=$(bw unlock --raw) ;;
    esac
    export BW_SESSION
    unlocked=1
    bw sync > /dev/null
}

restore_item() {
    path=$1
    item=$2
    recipient=$3

    mkdir -p "$(dirname "$path")"
    tmp=$(mktemp "$path.XXXXXX")
    if [ -f "$path" ]; then
        cat "$path" > "$tmp"
        echo >> "$tmp"
    fi
    if ! bw get notes "$item" < /dev/null >> "$tmp"; then
        echo "Couldn't read \"$item\" from Bitwarden. $path is unchanged." >&2
        exit 1
    fi
    echo >> "$tmp"
    if ! has_key "$tmp" "$recipient"; then
        echo "\"$item\" doesn't hold the key for $recipient. $path is unchanged." >&2
        exit 1
    fi
    mv -f "$tmp" "$path"
    tmp=""
    echo "restored $item"
}

if [ ! -r "$manifest" ]; then
    echo "Can't read $manifest. Run zakwas apply." >&2
    exit 1
fi

missing=$(missing_items)

if [ "${1:-}" = "--check" ]; then
    if [ -n "$missing" ]; then
        printf 'Missing from this Mac: %s\n' "$missing" >&2
        exit 1
    fi
    exit 0
fi

if [ -z "$missing" ]; then
    exit 0
fi

open_vault
while IFS="$tab" read -r path item recipient <&3; do
    case "$path" in "" | "#"*) continue ;; esac
    path=$(expand_path "$path")
    if ! has_key "$path" "$recipient"; then
        restore_item "$path" "$item" "$recipient"
    fi
done 3< "$manifest"
