[commit]
	gpgSign = true

[tag]
	gpgSign = true

[gpg]
	format = openpgp

[gpg "openpgp"]
	program = /opt/homebrew/bin/gpg

[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global

[pull]
	rebase = true

[format]
	signOff = true

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
